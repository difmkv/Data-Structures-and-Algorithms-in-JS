{
  "name": "data-structures-algorithms-js",
  "version": "1.0.0",
  "description": "Data Structures Algorithms JS",
  "author": "Diana Fdl <dianafdl@pm.me>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && parcel build src/index.html --public-url ./",
    "dev": "parcel src/index.html",
    "clear-build-cache": "rm -rf .cache/ dist/",
    "format": "prettier --ignore-path ./.gitignore --write \"./**/*.{html,json,js,css,*.test.js}\"",
    "format:check": "prettier --ignore-path ./.gitignore --check \"./**/*.{html,json,js,css}\"",
    "lint": "eslint --ignore-path ./.gitignore --fix ./**/*.js",
    "lint:check": "eslint --ignore-path ./.gitignore --quiet ./**/*.js",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "babel-jest": "^30.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "parcel": "^2.11.0",
    "prettier": "^3.2.5"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "coverageReporters": [
      "text",
      "html"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/difmkv/Data-Structures-and-Algorithms-in-JS"
  }
}
